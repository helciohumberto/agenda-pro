generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String   @id @default(uuid())
  businessName  String
  createdAt     DateTime @default(now())

  businesses Business[]
  staff      Staff[]
  services   Service[]
  clients    Client[]
  appointments Appointment[]

  @@map("tenants")
}

model Business {
  id       String @id @default(uuid())
  tenantId String
  name     String
  address  String?
  phone    String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("businesses")
}

model Staff {
  id           String @id @default(uuid())
  tenantId     String
  name         String
  email        String @unique
  role         String?
  passwordHash String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@map("staff")
}

model Service {
  id               String  @id @default(uuid())
  tenantId         String
  name             String
  price            Decimal
  durationMinutes  Int

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@map("services")
}

model Client {
  id       String @id @default(uuid())
  tenantId String
  name     String
  contact  String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@map("clients")
}

model Appointment {
  id          String   @id @default(uuid())
  tenantId    String
  clientId    String
  staffId     String
  serviceId   String
  scheduledAt DateTime
  status      String   @default("confirmed")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([staffId, scheduledAt], name: "unique_staff_slot")
  @@map("appointments")
}